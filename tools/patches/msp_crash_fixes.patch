+ ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+  Garbage Collector References
+ ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+*/
+
+// The user data and the group of a joint are Ruby objects that the native
+// data structure references. They have to remain reachable for the garbage
+// collector for as long as the joint exists, otherwise the collector can free
+// (or move) them while the joint still points at them, and a later use of the
+// pointer crashes the process. The hash of the world data that is registered
+// with the garbage collector holds them (see msp_world.h); the entry is keyed
+// by the address of the joint and removed when the joint is destroyed.
+static void c_update_gc_references(MSP::Joint::JointData* joint_data) {
+    MSP::World::WorldData* world_data = reinterpret_cast<MSP::World::WorldData*>(NewtonWorldGetUserData(joint_data->m_world));
+    if (world_data == nullptr)
+        return;
+    VALUE v_joint = MSP::Joint::c_joint_to_value(joint_data);
+    if (joint_data->m_user_data == Qnil && joint_data->m_group == Qnil) {
+        rb_hash_delete(world_data->m_joint_user_datas, v_joint);
+        return;
+    }
+    VALUE v_references = rb_ary_new_capa(2);
+    rb_ary_push(v_references, joint_data->m_user_data);
+    rb_ary_push(v_references, joint_data->m_group);
+    rb_hash_aset(world_data->m_joint_user_datas, v_joint, v_references);
+}
+
+static void c_clear_gc_references(MSP::Joint::JointData* joint_data) {
+    MSP::World::WorldData* world_data = reinterpret_cast<MSP::World::WorldData*>(NewtonWorldGetUserData(joint_data->m_world));
+    if (world_data == nullptr)
+        return;
+    rb_hash_delete(world_data->m_joint_user_datas, MSP::Joint::c_joint_to_value(joint_data));
+}
